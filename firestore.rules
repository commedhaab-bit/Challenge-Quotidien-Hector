// =============================================================================
// Base VERIFIEE contre les regles reellement deployees en production (comparees
// ligne a ligne le jour de la mise en place de la Phase 0 Cloud Functions - texte
// fourni directement depuis Firebase Console > Firestore Database > Regles).
//
// Sections ajoutees APRES cette verification initiale (leaderboardCache Phase 1,
// groups/* Phase 2, ...) : nouvelles, jamais en conflit avec les regles verifiees
// ci-dessus - Console verifiee de nouveau apres chaque deploiement reel (voir
// l'incident dailyContributors documente dans CLAUDE.md : verifier aussi les INDEX
// existants, pas seulement les regles, avant tout `firestore:indexes` deploy).
// =============================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /leaderboard/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
      // Kudos : n'importe quel utilisateur connecte peut incrementer UNIQUEMENT
      // kudosTotal de 1 (jamais un autre champ) sur le document de quelqu'un d'autre.
      // Gere explicitement le cas "kudosTotal n'existe pas encore" (1er kudos jamais
      // recu par cette personne) : sans ce cas, Firestore refuse l'evaluation de la
      // soustraction avec un champ absent et rejette l'ecriture (bug vecu en prod).
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kudosTotal'])
        && (
          (!('kudosTotal' in resource.data) && request.resource.data.kudosTotal == 1)
          || (('kudosTotal' in resource.data) && request.resource.data.kudosTotal - resource.data.kudosTotal == 1)
        );

      match /kudosGiven/{entryId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.voterUid == request.auth.uid;
      }
    }

    match /community/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;

      match /dailyContributors/{entryId} {
        allow read, write: if request.auth != null;
      }

      match /contributions/{contribId} {
        allow read, write: if request.auth != null;

        match /kudosBy/{voterUid} {
          allow read: if request.auth != null;
          allow create, delete: if request.auth != null && request.auth.uid == voterUid;
        }
      }
    }

    match /bossBattleArchive/{weekId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }

    // Pseudo public obligatoire : recherche exacte + reservation. Chaque pseudo
    // (minuscules uniquement) ne peut etre reclame que par son propre uid, et
    // uniquement libere par son proprietaire (renommage).
    match /usernames/{usernameLower} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && usernameLower.matches('^[a-z0-9_]{3,20}$');
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // Amis : demande mutuelle. friendRequests a un ID deterministe (fromUid_toUid),
    // friendships aussi (uidA_uidB tries) - un seul document par paire, jamais besoin
    // d'ecrire dans le document personnel de l'autre utilisateur. La creation d'une
    // friendship exige la preuve qu'une demande correspondante existe (dans un sens
    // ou l'autre) : impossible de se "auto-ajouter" ami sans passer par le flux de
    // demande.
    match /friendRequests/{reqId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.fromUid;
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
    }

    match /friendships/{pairId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.uidA || request.auth.uid == resource.data.uidB);
      allow create: if request.auth != null
        && (request.auth.uid == request.resource.data.uidA || request.auth.uid == request.resource.data.uidB)
        && (exists(/databases/$(database)/documents/friendRequests/$(request.resource.data.uidA + '_' + request.resource.data.uidB))
            || exists(/databases/$(database)/documents/friendRequests/$(request.resource.data.uidB + '_' + request.resource.data.uidA)));
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.uidA || request.auth.uid == resource.data.uidB);
    }

    match /users/{userId}/notifications/{notifId} {
      allow create: if request.auth != null && request.resource.data.fromUid == request.auth.uid;
    }

    // Fil d'activite global (amis) : un document par defi complete.
    match /activityFeed/{entryId} {
      allow read, write: if request.auth != null;

      match /kudosBy/{voterUid} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null && request.auth.uid == voterUid;
      }
    }

    // ===========================================================================
    // AJOUT Phase 0/1 (classement precalcule cote serveur)
    // ===========================================================================
    // Ecrit UNIQUEMENT par aggregateLeaderboard (Cloud Function, Admin SDK - les
    // regles ci-dessous ne s'appliquent qu'aux clients, l'Admin SDK les contourne
    // toujours). Volontairement AUCUNE regle d'ecriture cliente : par omission,
    // toute tentative d'ecriture depuis un client est refusee.
    match /leaderboardCache/{view} {
      allow read: if request.auth != null;
    }

    // ===========================================================================
    // Phase 2 : Groupes & Defis Collectifs (fondations)
    // ===========================================================================
    match /groups_by_code/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null; // meme logique create-only que usernames/{pseudo}
    }
    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      // Seul memberCount peut etre modifie par un client (increment a l'adhesion) -
      // name/emoji/code/createdBy sont immuables une fois le groupe cree.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount']);

      match /members/{memberUid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == memberUid;
      }
      match /challenges/{challengeId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        // Le doc defi (status/currentProgress) n'est modifie que par
        // closeExpiredGroupChallenges (Admin SDK, contourne ces regles) - aucune
        // regle update cliente ici.

        match /participants/{participantUid} {
          // Chaque membre n'ecrit QUE son propre doc participant (totalAmount) -
          // tout effet croise (jokers, Phase 4) passera par une Cloud Function dediee.
          allow read: if request.auth != null;
          allow write: if request.auth != null && request.auth.uid == participantUid;
        }
        // Historique horodate (Phase 3, detection de Clutch Win) : create-only,
        // jamais de update/delete client - chaque evenement s'auto-attribue son uid,
        // meme principe que activityFeed/{id}.
        match /contributions/{entryId} {
          allow read: if request.auth != null;
          allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
        }
      }
      match /ledger/{entryId} {
        // Ecrit uniquement par closeExpiredGroupChallenges (Admin SDK) ; le client
        // ne peut que marquer honoredAt/honoredBy (bouton "Gage honore !").
        allow read: if request.auth != null;
        allow update: if request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['honoredAt', 'honoredBy']);
      }
    }
  }
}
